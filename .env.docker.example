# =============================================================================
# Graph RAG Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.docker.example .env

# -----------------------------------------------------------------------------
# LLM Provider & Credentials
# -----------------------------------------------------------------------------
# LLM_PROVIDER options: "openai" | "claude"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
# Optional custom OpenAI base URL (e.g., OpenRouter, proxy):
# OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic API Key (required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional custom Anthropic base URL:
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# -----------------------------------------------------------------------------
# Embeddings Configuration
# -----------------------------------------------------------------------------
# Embeddings use OpenAI API or compatible embedding endpoints
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
# Optional custom embedding base URL:
# EMBEDDINGS_OPENAI_API_BASE=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Database Credentials (PostgreSQL / pgvector)
# -----------------------------------------------------------------------------
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=graph_rag_db

# -----------------------------------------------------------------------------
# Graph Database Credentials (Neo4j)
# -----------------------------------------------------------------------------
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_AUTH=neo4j/password

# -----------------------------------------------------------------------------
# Object Storage Credentials (MinIO)
# -----------------------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
