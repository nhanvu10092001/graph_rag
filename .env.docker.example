# =============================================================================
# Graph RAG Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.docker.example .env

# -----------------------------------------------------------------------------
# LLM Provider & Credentials (Anthropic Claude)
# -----------------------------------------------------------------------------
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional custom Anthropic base URL / proxy:
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# -----------------------------------------------------------------------------
# Embeddings Configuration (Self-hosted nomic-embed-text-v1.5 via local vLLM)
# -----------------------------------------------------------------------------
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=nomic-ai/nomic-embed-text-v1.5
# Optional custom embedding base URL (defaults to internal http://embedding:8000/v1 in Docker):
# EMBEDDINGS_OPENAI_API_BASE=http://embedding:8000/v1

# -----------------------------------------------------------------------------
# Database Credentials (PostgreSQL / pgvector)
# -----------------------------------------------------------------------------
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=graph_rag_db

# -----------------------------------------------------------------------------
# Graph Database Credentials (Neo4j)
# -----------------------------------------------------------------------------
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_AUTH=neo4j/password

# -----------------------------------------------------------------------------
# Object Storage Credentials (MinIO)
# -----------------------------------------------------------------------------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# -----------------------------------------------------------------------------
# OCR Service (PaddleOCR-VL via vLLM)
# -----------------------------------------------------------------------------
PADDLE_OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5
# Optional Hugging Face Hub Token if accessing gated models
# HUGGING_FACE_HUB_TOKEN=your_huggingface_token_here

